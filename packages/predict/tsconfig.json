{
  "compilerOptions": {
    "target": "es2021",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "devtools/ts/**/*.ts",
    "deployment/**/*.ts",
    "harness/ts/**/*.ts",
    "simulations/src/**/*.ts"
  ]
}
